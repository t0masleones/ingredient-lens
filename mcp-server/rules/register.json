{
  "schema_version": 1,
  "rules_version": "0.6.0",
  "updated": "2026-10-17",
  "policy": {
    "content_verified": "primary = official text read; secondary = reputable secondary source; unverified = not yet checked. A rule whose basis is unverified for a market never returns pass or fail there, only review.",
    "effective_source": "Same scale for the date the rule applies from. Unverified dates are shown, never used to turn a check off.",
    "review_cadence": "Every rule has a next review date. CI fails when a review is overdue, so regulatory drift is caught by the build.",
    "change_control": "A change to a rule's behaviour needs a test, a changelog line and a new rules_version. Disputed mappings and rule changes use the GitHub issue forms in .github/ISSUE_TEMPLATE/."
  },
  "rules": [
    {
      "id": "ALG-DECL",
      "check": "Allergen declaration",
      "type": "compliance",
      "intent": "Every allergen the market requires that appears in the ingredients is declared on the label in the form the market prescribes.",
      "engine_behaviour": "n/a when no required allergen is listed; pass when the statement covers them; fail when the statement is missing (BR) or incomplete (XC2); review in the US when the statement is missing (the source may be in parentheses) and always in the EU (emphasis is not visible in text).",
      "applies": [
        {
          "market": "BR",
          "citation": "RDC 26/2015 (consolidated in RDC 727/2022), Anvisa",
          "url": "https://www.legisweb.com.br/legislacao/?id=286510",
          "effective_from": "2016-07-03",
          "effective_source": "secondary",
          "content_verified": "secondary",
          "note": "Published 3 Jul 2015 with 12 months to adapt; Anvisa refused an extension."
        },
        {
          "market": "US",
          "citation": "FALCPA 2004 (Public Law 108-282); FASTER Act 2021 (sesame)",
          "url": "https://www.fda.gov/food/nutrition-food-labeling-and-critical-foods/food-allergies",
          "effective_from": "2006-01-01",
          "effective_source": "unverified",
          "content_verified": "primary",
          "note": "Sesame is a major allergen from 1 Jan 2023 (verified on the FDA page); 2006-01-01 for FALCPA is commonly cited, to verify."
        },
        {
          "market": "EU",
          "citation": "Regulation (EU) No 1169/2011, Article 21 and Annex II",
          "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32011R1169",
          "effective_from": "2014-12-13",
          "effective_source": "unverified",
          "content_verified": "primary"
        }
      ],
      "since": "0.4.0",
      "history": [
        {
          "version": "0.2.0",
          "change": "Statement completeness as cross-check XC2."
        },
        {
          "version": "0.4.0",
          "change": "Checklist row per market; each market checks only the allergens it requires."
        },
        {
          "version": "0.6.0",
          "change": "Statements printed inside an ingredient's parentheses (\"arôme (contient alcool)\", \"vinagre (contém sulfitos)\") no longer end the list or count as the label's allergen statement, and an unclosed parenthesis in OCR text no longer hides the rest of the label; found by reference B and the ingredient-order property in the v0.6 benchmark."
        }
      ],
      "tests": [
        "test_safety_and_compliance.py::test_br_complete_label_passes",
        "test_safety_and_compliance.py::test_br_missing_statements_fail",
        "test_safety_and_compliance.py::test_us_allergen_without_statement_is_review",
        "test_safety_and_compliance.py::test_eu_emphasis_is_always_review",
        "test_benchmark_findings.py::test_parenthetical_contains_is_not_the_allergen_statement",
        "test_benchmark_findings.py::test_contains_one_or_more_of_the_following_lists_ingredients",
        "test_benchmark_findings.py::test_unclosed_parenthesis_does_not_swallow_the_may_contain_statement",
        "test_benchmark_findings.py::test_unclosed_parenthesis_before_contains_keeps_the_list"
      ],
      "last_reviewed": "2026-10-17",
      "review_every_months": 6
    },
